# ==============================================================================
# NeoMCQ Production Environment Variables Blueprint
# ==============================================================================

# Gemini AI Engine (Server-side API Key)
GEMINI_API_KEY=

# Application URLs & Domain Configuration
APP_URL=https://neomcq.com
NEXT_PUBLIC_SITE_URL=https://neomcq.com

# Supabase Infrastructure Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
POSTGRES_URL=

# Razorpay Payment Gateway (Server-side & Client-side)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 Object Storage Credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
